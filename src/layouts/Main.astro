---
import "../styles/global.css";
import "@fw-vision/web-kit/styles/tokens.css";
import "@fw-vision/web-kit/styles/annotation-tokens.css";

export interface Props {
  title: string;
  description?: string;
  lang?: string;
  activePath?: string;
}

const { title, description, lang = "en", activePath = "" } = Astro.props;

const navLinks = [
  { label: "About", href: `/${lang}/about` },
  { label: "District", href: `/${lang}/district` },
  { label: "Futures", href: `/${lang}/futures` },
  { label: "Approach", href: `/${lang}/approach` },
  { label: "Research", href: `/${lang}/research` },
  { label: "Partners", href: `/${lang}/partners` },
  { label: "Insights", href: `/${lang}/insights` },
  { label: "Contact", href: `/${lang}/contact` },
];

const locales = [
  { code: "en", href: activePath ? `/en${activePath}` : "/en/" },
  { code: "fr", href: activePath ? `/fr${activePath}` : "/fr/" },
  { code: "zh", href: activePath ? `/zh${activePath}` : "/zh/" },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body class="bg-canvas text-ink antialiased">
    <header class="border-b border-hairline">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-6 lg:px-10">
        <a
          href={`/${lang}/`}
          class="font-display text-base font-semibold tracking-tight text-ink"
        >
          SyncID Labs
        </a>
        <nav class="hidden items-center gap-7 lg:flex">
          {
            navLinks.map((link) => (
              <a
                href={link.href}
                class="text-sm text-graphite transition-colors hover:text-ink"
                aria-current={activePath === link.href.replace(`/${lang}`, "") ? "page" : undefined}
              >
                {link.label}
              </a>
            ))
          }
        </nav>
        <div class="flex items-center gap-1">
          {
            locales.map((loc) => (
              <a
                href={loc.href}
                class:list={[
                  "px-2 py-1 text-xs uppercase tracking-[0.15em] transition-colors",
                  loc.code === lang
                    ? "font-semibold text-ink"
                    : "text-graphite/50 hover:text-graphite",
                ]}
              >
                {loc.code}
              </a>
            ))
          }
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="mt-28 border-t border-hairline">
      <div class="mx-auto max-w-7xl px-6 py-14 lg:px-10">
        <div class="flex flex-col justify-between gap-10 md:flex-row">
          <div>
            <p class="font-display text-base font-semibold text-ink">SyncID Labs</p>
            <p class="mt-3 max-w-sm text-sm leading-relaxed text-graphite">
              Actualizing Canada's strategic futures. An innovation district, real pipelines,
              and coalitions of ventures, built on 89 acres in Markham.
            </p>
          </div>
          <nav class="flex flex-col gap-2.5 text-sm text-graphite">
            <a href={`/${lang}/about`} class="transition-colors hover:text-ink">About</a>
            <a href={`/${lang}/research`} class="transition-colors hover:text-ink">Research</a>
            <a href={`/${lang}/partners`} class="transition-colors hover:text-ink">Partners</a>
            <a href={`/${lang}/contact`} class="transition-colors hover:text-ink">Contact</a>
            <a href={`/${lang}/legal/privacy`} class="transition-colors hover:text-ink">Privacy</a>
            <a href={`/${lang}/legal/terms`} class="transition-colors hover:text-ink">Terms</a>
          </nav>
        </div>
        <p class="mt-12 text-xs tracking-wide text-graphite/60">
          &copy; {new Date().getFullYear()} SyncID Labs. Synchronous Incubation and Development Labs.
        </p>
      </div>
    </footer>
  </body>
</html>
