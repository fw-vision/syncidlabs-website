---
import "@fw-vision/web-kit/styles/tokens.css";
import "@fw-vision/web-kit/styles/annotation-tokens.css";
/* SyncID tokens must load after web-kit so --wk-accent burgundy wins over the kit default. */
import "../styles/global.css";
import Wordmark from "../components/Wordmark.astro";

export interface Props {
  title: string;
  description?: string;
  lang?: string;
  activePath?: string;
  /** When true, the nav starts transparent over a dark hero and turns solid on scroll. */
  heroNav?: boolean;
  /**
   * When true, reduce the gap above the footer. Use when the last page band
   * (e.g. a logo ticker) should sit symmetrically against the footer rule.
   */
  tightFooter?: boolean;
}

const {
  title,
  description,
  lang = "en",
  activePath = "",
  heroNav = false,
  tightFooter = false,
} = Astro.props;

  const navLinks = [
    { label: "Network", href: `/${lang}/network` },
    { label: "The Canadian Gap", href: `/${lang}/research` },
    { label: "Approach", href: `/${lang}/approach` },
    { label: "Futures", href: `/${lang}/futures` },
    { label: "District", href: `/${lang}/district` },
    { label: "Insights", href: `/${lang}/insights` },
    { label: "Contact", href: `/${lang}/contact` },
  ];

/** Full locale map kept for the deferred FR/ZH pass. Only visibleLocales render in nav. */
const allLocales = [
  { code: "en", href: activePath ? `/en${activePath}` : "/en/" },
  { code: "fr", href: activePath ? `/fr${activePath}` : "/fr/" },
  { code: "zh", href: activePath ? `/zh${activePath}` : "/zh/" },
];
const visibleLocales = ["en"];
const locales = allLocales.filter((loc) => visibleLocales.includes(loc.code));
const showLanguageNav = locales.length > 1;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://api.fontshare.com/v2/css?f[]=satoshi@300,400,500,700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body class:list={["bg-canvas text-ink antialiased", heroNav && "has-hero"]}>
    <header
      id="site-header"
      data-hero-nav={heroNav ? "true" : "false"}
      class:list={[
        "fixed inset-x-0 top-0 z-50 transition-colors duration-300",
        heroNav ? "is-hero" : "is-solid border-b border-hairline bg-canvas/90 backdrop-blur",
      ]}
    >
      <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5 lg:px-10">
        <a href={`/${lang}/`} class="site-brand" aria-label="SyncI&DLabs home">
          <Wordmark variant="nav" class="brand-text text-lg" />
        </a>
        <nav class="hidden items-center gap-7 lg:flex">
          {
            navLinks.map((link) => (
              <a
                href={link.href}
                class="nav-link text-sm transition-colors"
                aria-current={activePath === link.href.replace(`/${lang}`, "") ? "page" : undefined}
              >
                {link.label}
              </a>
            ))
          }
        </nav>
        {
          showLanguageNav && (
            <div class="flex items-center gap-1">
              {locales.map((loc) => (
                <a
                  href={loc.href}
                  class:list={[
                    "nav-locale px-2 py-1 text-xs uppercase tracking-[0.15em] transition-colors",
                    loc.code === lang ? "is-active font-semibold" : "",
                  ]}
                >
                  {loc.code}
                </a>
              ))}
            </div>
          )
        }
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class:list={[tightFooter ? "mt-6" : "mt-28", "border-t border-hairline"]}>
      <div class="mx-auto max-w-7xl px-6 py-16 lg:px-10">
        <div class="flex flex-col justify-between gap-10 md:flex-row">
          <div>
            <span class="block font-display leading-[0.95] tracking-[-0.03em]">
              <span class="block text-lg font-medium text-graphite">Synchronous</span>
              <span class="block text-2xl font-semibold text-ink">
                <span class="accent-mark" style="color: var(--wk-accent);">I&amp;D</span> Labs Inc.
              </span>
            </span>
            <p class="mt-4 max-w-sm text-sm leading-relaxed text-graphite">
              We understand Canada's innovation ecosystems and actualize the opportunities
              they reveal. The district is the vehicle.
            </p>
          </div>
          <nav class="flex flex-col gap-2.5 text-sm text-graphite">
            <a href={`/${lang}/network`} class="transition-colors hover:text-ink">Network</a>
            <a href={`/${lang}/research`} class="transition-colors hover:text-ink">The Canadian Gap</a>
            <a href={`/${lang}/district`} class="transition-colors hover:text-ink">District</a>
            <a href={`/${lang}/insights`} class="transition-colors hover:text-ink">Insights</a>
            <a href={`/${lang}/contact`} class="transition-colors hover:text-ink">Contact</a>
            <a href={`/${lang}/legal/privacy`} class="transition-colors hover:text-ink">Privacy</a>
            <a href={`/${lang}/legal/terms`} class="transition-colors hover:text-ink">Terms</a>
          </nav>
        </div>
        <p class="mt-12 text-xs tracking-wide text-graphite/60">
          &copy; {new Date().getFullYear()} Synchronous I&amp;D Labs Inc. Actualizing Canada's strategic futures.
        </p>
      </div>
    </footer>

    <script is:inline>
      (function () {
        const header = document.getElementById("site-header");
        if (!header || header.dataset.heroNav !== "true") return;
        const threshold = 120;
        const sync = () => {
          if (window.scrollY > threshold) {
            header.classList.add("scrolled");
          } else {
            header.classList.remove("scrolled");
          }
        };
        sync();
        window.addEventListener("scroll", sync, { passive: true });
      })();
    </script>
  </body>
</html>
