---
/**
 * DG-3: Hybrid Intelligence pairing.
 * Two overlapping hairline circles (Human / Agentic AI); overlap tinted light burgundy.
 */
---

<figure class="diagram-frame w-full border border-hairline bg-canvas p-6 sm:p-8">
  <svg viewBox="0 0 480 320" class="mx-auto h-auto w-full max-w-lg" role="img" aria-label="Hybrid Intelligence: human judgment paired with agentic scale">
    <circle cx="185" cy="160" r="95" fill="none" stroke="#e4e4e2" stroke-width="1.5" />
    <circle cx="295" cy="160" r="95" fill="none" stroke="#e4e4e2" stroke-width="1.5" />
    <!-- Overlap tint -->
    <path
      d="M240 78 A95 95 0 0 1 240 242 A95 95 0 0 1 240 78 Z"
      fill="var(--wk-accent)"
      opacity="0.12"
    />
    <text x="130" y="165" text-anchor="middle" font-family="var(--font-display), sans-serif" font-size="13" fill="#0a0808">Human</text>
    <text x="130" y="184" text-anchor="middle" font-family="var(--font-sans), sans-serif" font-size="10" fill="#33383d">governance</text>
    <text x="350" y="165" text-anchor="middle" font-family="var(--font-display), sans-serif" font-size="13" fill="#0a0808">Agentic AI</text>
    <text x="350" y="184" text-anchor="middle" font-family="var(--font-sans), sans-serif" font-size="10" fill="#33383d">scale</text>
    <text x="240" y="168" text-anchor="middle" font-family="var(--font-display), sans-serif" font-size="11" fill="var(--wk-accent)">Hybrid</text>
  </svg>
  <figcaption class="mt-4 text-center text-xs tracking-wide text-graphite/60">
    Hybrid Intelligence: pairing, not replacement
  </figcaption>
</figure>
