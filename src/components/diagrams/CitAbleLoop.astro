---
/**
 * DG-4: CITAble assessment loop — Define → Build → Evaluate → co-evolve.
 */
---

<figure class="diagram-frame w-full border border-hairline bg-canvas p-6 sm:p-8">
  <svg viewBox="0 0 480 320" class="mx-auto h-auto w-full max-w-lg" role="img" aria-label="CITAble assessment loop: define, build, evaluate">
    <!-- Arc ring -->
    <circle cx="240" cy="160" r="100" fill="none" stroke="#e4e4e2" stroke-width="1" stroke-dasharray="4 6" />
    <!-- Nodes -->
    <g>
      <rect x="188" y="42" width="104" height="36" fill="#fff" stroke="var(--wk-accent)" stroke-width="1.5" />
      <text x="240" y="64" text-anchor="middle" font-family="var(--font-display), sans-serif" font-size="13" fill="#0a0808">Define</text>
    </g>
    <g>
      <rect x="330" y="142" width="104" height="36" fill="#fff" stroke="#e4e4e2" stroke-width="1.5" />
      <text x="382" y="164" text-anchor="middle" font-family="var(--font-display), sans-serif" font-size="13" fill="#0a0808">Build</text>
    </g>
    <g>
      <rect x="188" y="242" width="104" height="36" fill="#fff" stroke="#e4e4e2" stroke-width="1.5" />
      <text x="240" y="264" text-anchor="middle" font-family="var(--font-display), sans-serif" font-size="13" fill="#0a0808">Evaluate</text>
    </g>
    <!-- Curved arrow markers (simple chevrons) -->
    <path d="M300 70 Q360 90 372 140" fill="none" stroke="var(--wk-accent)" stroke-width="1.5" marker-end="url(#arrow)" />
    <path d="M372 180 Q360 230 300 250" fill="none" stroke="var(--wk-accent)" stroke-width="1.5" />
    <path d="M180 250 Q120 200 120 160 Q120 100 180 70" fill="none" stroke="var(--wk-accent)" stroke-width="1.5" />
    <defs>
      <marker id="arrow" markerWidth="6" markerHeight="6" refX="5" refY="3" orient="auto">
        <path d="M0,0 L6,3 L0,6 Z" fill="var(--wk-accent)" />
      </marker>
    </defs>
    <text x="240" y="165" text-anchor="middle" font-family="var(--font-sans), sans-serif" font-size="10" fill="#33383d">co-evolve</text>
  </svg>
  <figcaption class="mt-4 text-center text-xs tracking-wide text-graphite/60">
    CITAble assessment loop
  </figcaption>
</figure>
