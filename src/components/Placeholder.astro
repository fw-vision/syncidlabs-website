---
/**
 * A labelled placeholder frame. Makes a content/image gap VISIBLE and
 * plannable rather than hiding it behind filler. Use during the scaffold
 * phase; replace with real media/copy before launch.
 *
 * kind="image"  -> a framed box describing the image to gather
 * kind="video"  -> same, for a video/loop
 * kind="copy"   -> a dashed block describing copy to write
 * kind="data"   -> a slot for a chart/diagram/map
 */
export interface Props {
  kind?: "image" | "video" | "copy" | "data";
  label: string;
  note?: string;
  ratio?: string; // e.g. "16/9", "4/3", "1/1"
  dark?: boolean;
}
const { kind = "image", label, note, ratio = "16/9", dark = false } = Astro.props;

const kindLabel = {
  image: "Image needed",
  video: "Video needed",
  copy: "Copy needed",
  data: "Data / diagram needed",
}[kind];
---

<div
  class:list={[
    "placeholder-frame flex flex-col items-center justify-center border border-dashed p-6 text-center",
    dark ? "border-white/30 bg-white/5 text-white/70" : "border-graphite/30 bg-neutral-50 text-graphite/70",
  ]}
  style={`aspect-ratio: ${ratio};`}
  data-placeholder={kind}
>
  <span
    class="eyebrow"
    style="color: var(--wk-accent);"
  >
    {kindLabel}
  </span>
  <span class="mt-3 max-w-md font-display text-base font-medium leading-snug">
    {label}
  </span>
  {note && <span class="mt-2 max-w-sm text-xs leading-relaxed opacity-70">{note}</span>}
</div>
