---
/**
 * Featured article / event card: image, category tags, title, date/meta.
 * Squared, hairline. Tech Barcelona news/event card pattern.
 */
export interface Props {
  image: string;
  title: string;
  href?: string;
  date?: string;
  categories?: string[];
  meta?: string;
}
const { image, title, href = "#", date, categories = [], meta } = Astro.props;
---

<a href={href} class="card-lift group flex h-full flex-col border-0 bg-canvas">
  <div class="aspect-[16/10] w-full overflow-hidden bg-neutral-100">
    <img
      src={image}
      alt=""
      loading="lazy"
      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
    />
  </div>
  <div class="flex flex-1 flex-col p-6">
    {
      categories.length > 0 && (
        <div class="mb-3 flex flex-wrap gap-2">
          {categories.map((c) => (
            <span class="eyebrow text-graphite/60">{c}</span>
          ))}
        </div>
      )
    }
    <h3 class="font-display text-lg font-medium leading-snug text-ink group-hover:text-[color:var(--wk-accent)]">
      {title}
    </h3>
    {
      meta && (
        <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-graphite">{meta}</p>
      )
    }
    {date && <p class="mt-auto pt-4 text-sm text-graphite/60">{date}</p>}
  </div>
</a>
