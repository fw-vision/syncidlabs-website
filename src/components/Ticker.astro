---
/**
 * Scrolling ticker / marquee. Duplicates its items once so the CSS
 * translateX(-50%) loop is seamless. Pauses on hover.
 */
export interface Props {
  items: string[];
  dark?: boolean;
  separator?: string;
}
const { items, dark = false, separator = "\u2197" } = Astro.props;
const doubled = [...items, ...items];
---

<div
  class:list={[
    "ticker border-y",
    dark ? "border-white/15 bg-ink text-white" : "border-hairline bg-canvas text-ink",
  ]}
>
  <div class="ticker__track">
    {
      doubled.map((item) => (
        <span class="ticker__item" aria-hidden={items.includes(item) ? undefined : "true"}>
          <span>{item}</span>
          <span style="color: var(--wk-accent);">{separator}</span>
        </span>
      ))
    }
  </div>
</div>
