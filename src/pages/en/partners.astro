---
import Main from "../../layouts/Main.astro";
import PageHeader from "../../components/PageHeader.astro";

const sections = [
  {
    audience: "Capital",
    body: "A de-risked, methodology-backed coalition play toward defined Canadian futures. Returns without venture-studio dilution or origination risk, in the durable market of crossing firms back over the chasm.",
  },
  {
    audience: "Institutions",
    body: "Bring your research and your alumni to a district built for actualizing Canada's futures. We offer space, access, and mission alignment.",
  },
  {
    audience: "Founders",
    body: "Place, peers, mission, and mentorship. A prime Markham location alongside top researchers, in a coalition building a sovereign Canada. The alternative to the accelerator model.",
  },
];
---

<Main
  title="Partners - SyncID Labs"
  description="For capital, institutions, and founders. Join the district that actualizes Canada's strategic futures."
  lang="en"
  activePath="/partners"
>
  <PageHeader eyebrow="Partners" title="Endorse it, invest in it, or join it." />

  <section class="border-b border-hairline">
    <div class="mx-auto max-w-7xl px-6 py-16 lg:px-10">
      <div class="divide-y divide-hairline border-y border-hairline">
        {
          sections.map((s) => (
            <div class="grid gap-6 py-12 lg:grid-cols-12">
              <div class="lg:col-span-3">
                <h2 class="font-display text-2xl font-medium text-ink">{s.audience}</h2>
              </div>
              <div class="lg:col-span-9">
                <p class="max-w-2xl text-lg leading-relaxed text-graphite">{s.body}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section>
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-10">
      <a
        href="/en/contact"
        class="inline-flex items-center px-7 py-3.5 text-sm font-medium text-white transition-opacity hover:opacity-90"
        style="background-color: var(--wk-accent);"
      >
        Start a conversation
      </a>
    </div>
  </section>
</Main>
