---
import Main from "../../layouts/Main.astro";

const steps = [
  {
    n: "01",
    title: "Define the strategic futures",
    body: "We name the strategic futures worth building for Canada, from food sovereignty and sovereign compute to the future of work.",
  },
  {
    n: "02",
    title: "Build the pipelines and coalitions",
    body: "Real founders, researchers, and retooled firms, gathered into blended funds per future. The Constellation play, not empty buildings.",
  },
  {
    n: "03",
    title: "Evaluate and iterate",
    body: "CITAble assessment that co-evolves with outcomes, so the district proves itself as it grows.",
  },
];

const diff = [
  { vs: "A developer", us: "We build ventures, not just buildings." },
  { vs: "A university or government program", us: "We build market share, not just research." },
  { vs: "A passive investor", us: "We actualize the coalition, not just fund it." },
];
---

<Main
  title="The Actualizer Method - SyncID Labs"
  description="A self-evaluating methodology: Hybrid Intelligence and CITAble assessment. Define the futures, build the coalitions, evaluate and iterate."
  lang="en"
  activePath="/approach"
>
  <section class="border-b border-neutral-200">
    <div class="mx-auto max-w-3xl px-6 py-20">
      <h1 class="text-4xl font-semibold tracking-tight text-neutral-900">The actualizer method</h1>
      <p class="mt-6 text-lg leading-relaxed text-neutral-700">
        Our methodology, Hybrid Intelligence&trade; and CITAble&trade; assessment, is
        self-evaluating: the district proves itself as it grows.
      </p>

      <div class="mt-12 space-y-10">
        {
          steps.map((s) => (
            <div class="flex gap-6">
              <span class="text-2xl font-semibold" style="color: var(--wk-accent);">
                {s.n}
              </span>
              <div>
                <h2 class="text-lg font-semibold text-neutral-900">{s.title}</h2>
                <p class="mt-2 text-neutral-600">{s.body}</p>
              </div>
            </div>
          ))
        }
      </div>

      <h2 class="mt-16 text-2xl font-semibold text-neutral-900">How we differ</h2>
      <div class="mt-6 divide-y divide-neutral-200 border-y border-neutral-200">
        {
          diff.map((d) => (
            <div class="flex flex-col gap-1 py-4 sm:flex-row sm:gap-8">
              <span class="w-full text-sm font-medium text-neutral-500 sm:w-64">{d.vs}</span>
              <span class="text-neutral-800">{d.us}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Main>
