---
import Main from "../../layouts/Main.astro";
import PageHeader from "../../components/PageHeader.astro";

const steps = [
  {
    n: "01",
    title: "Define the strategic futures",
    body: "We name the strategic futures worth building for Canada, from food sovereignty and sovereign compute to the future of work.",
  },
  {
    n: "02",
    title: "Build the pipelines and coalitions",
    body: "Real founders, researchers, and retooled firms, gathered into blended funds per future. The Constellation play, not empty buildings.",
  },
  {
    n: "03",
    title: "Evaluate and iterate",
    body: "CITAble assessment that co-evolves with outcomes, so the district proves itself as it grows.",
  },
];

const diff = [
  { vs: "A developer", us: "We build ventures, not just buildings." },
  { vs: "A university or government program", us: "We build market share, not just research." },
  { vs: "A passive investor", us: "We actualize the coalition, not just fund it." },
];
---

<Main
  title="The Actualizer Method - SyncID Labs"
  description="A self-evaluating methodology: Hybrid Intelligence and CITAble assessment. Define the futures, build the coalitions, evaluate and iterate."
  lang="en"
  activePath="/approach"
>
  <PageHeader
    eyebrow="The actualizer method"
    title="A methodology that proves itself as it grows."
    lead="Our approach, Hybrid Intelligence™ and CITAble™ assessment, is self-evaluating."
  />

  <section class="border-b border-hairline">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-10">
      <div class="grid grid-cols-1 gap-px bg-hairline md:grid-cols-3">
        {
          steps.map((s) => (
            <div class="bg-canvas p-9">
              <span class="font-display text-3xl font-semibold" style="color: var(--wk-accent);">
                {s.n}
              </span>
              <h2 class="font-display mt-5 text-xl font-medium text-ink">{s.title}</h2>
              <p class="mt-3 text-base leading-relaxed text-graphite">{s.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section>
    <div class="mx-auto max-w-3xl px-6 py-20 lg:px-10">
      <p class="eyebrow text-graphite/60">How we differ</p>
      <div class="mt-8 divide-y divide-hairline border-y border-hairline">
        {
          diff.map((d) => (
            <div class="flex flex-col gap-1 py-5 sm:flex-row sm:gap-8">
              <span class="w-full text-sm font-medium text-graphite sm:w-72">{d.vs}</span>
              <span class="text-lg text-ink">{d.us}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Main>
