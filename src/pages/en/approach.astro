---
import Main from "../../layouts/Main.astro";
import PageHeader from "../../components/PageHeader.astro";
import Placeholder from "../../components/Placeholder.astro";

const steps = [
  {
    n: "01",
    title: "Define the strategic futures",
    body: "We name the strategic futures worth building for Canada, from food sovereignty and sovereign compute to the future of work.",
  },
  {
    n: "02",
    title: "Build the pipelines and coalitions",
    body: "Real founders, researchers, and retooled firms, gathered into blended funds per future. The Constellation play, not empty buildings.",
  },
  {
    n: "03",
    title: "Evaluate and iterate",
    body: "CITAble assessment that co-evolves with outcomes, so the district proves itself as it grows.",
  },
];

const diff = [
  { vs: "A developer", us: "We build ventures, not just buildings." },
  { vs: "A university or government program", us: "We build market share, not just research." },
  { vs: "A passive investor", us: "We actualize the coalition, not just fund it." },
];
---

<Main
  title="The Actualizer Method - SyncID Labs"
  description="A self-evaluating methodology: Hybrid Intelligence and CITAble assessment. Define the futures, build the coalitions, evaluate and iterate."
  lang="en"
  activePath="/approach"
>
  <PageHeader
    eyebrow="The actualizer method"
    title="A methodology that proves itself as it grows."
    lead="Our approach, Hybrid Intelligence&trade; and CITAble&trade; assessment, is self-evaluating."
  />

  <!-- The three-step method -->
  <section class="border-b border-hairline">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-10">
      <p class="eyebrow text-graphite/60">The method, in three steps</p>
      <div class="mt-10 grid grid-cols-1 gap-px bg-hairline md:grid-cols-3">
        {
          steps.map((s) => (
            <div class="bg-canvas p-9">
              <span class="font-display text-3xl font-semibold" style="color: var(--wk-accent);">
                {s.n}
              </span>
              <h2 class="font-display mt-5 text-xl font-medium text-ink">{s.title}</h2>
              <p class="mt-3 text-base leading-relaxed text-graphite">{s.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Hybrid Intelligence concept -->
  <section class="border-b border-hairline">
    <div class="mx-auto grid max-w-7xl items-center gap-12 px-6 py-20 lg:grid-cols-2 lg:px-10">
      <div>
        <p class="eyebrow text-graphite/60">Hybrid Intelligence&trade;</p>
        <h2 class="font-display mt-6 text-3xl font-medium leading-tight text-ink sm:text-4xl">
          Humans at the centre, agentic systems at scale.
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-graphite">
          Human governance and judgment paired with AI fleets that carry the volume. The pairing,
          not the replacement, is what makes the method credible and repeatable.
        </p>
      </div>
      <Placeholder
        kind="data"
        ratio="4/3"
        label="Hybrid Intelligence diagram: humans (governance/judgment) paired with agentic scale"
        note="Candidate for a fw-vision dataviz widget: a pairing/augmentation visual, not replacement."
      />
    </div>
  </section>

  <!-- CITAble assessment -->
  <section class="border-b border-hairline">
    <div class="mx-auto grid max-w-7xl items-center gap-12 px-6 py-20 lg:grid-cols-2 lg:px-10">
      <Placeholder
        kind="data"
        ratio="4/3"
        label="CITAble assessment loop: define, build, evaluate, co-evolve"
        note="A cyclical diagram showing the self-evaluating loop. Could reuse the CITEMap / index-radar widgets."
        dark={false}
      />
      <div class="lg:order-first lg:hidden"></div>
      <div>
        <p class="eyebrow text-graphite/60">CITAble&trade; assessment</p>
        <h2 class="font-display mt-6 text-3xl font-medium leading-tight text-ink sm:text-4xl">
          A district that measures itself as it grows.
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-graphite">
          CITAble assessment co-evolves with outcomes. The evaluation is not a report at the end;
          it is a loop that steers what we build next.
        </p>
      </div>
    </div>
  </section>

  <!-- Differentiation -->
  <section>
    <div class="mx-auto max-w-3xl px-6 py-20 lg:px-10">
      <p class="eyebrow text-graphite/60">How we differ</p>
      <div class="mt-8 divide-y divide-hairline border-y border-hairline">
        {
          diff.map((d) => (
            <div class="flex flex-col gap-1 py-5 sm:flex-row sm:gap-8">
              <span class="w-full text-sm font-medium text-graphite sm:w-72">{d.vs}</span>
              <span class="text-lg text-ink">{d.us}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Main>
