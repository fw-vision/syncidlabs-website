---
import { getCollection } from "astro:content";
import Main from "../../layouts/Main.astro";
import PageHeader from "../../components/PageHeader.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { BAN_INSIGHTS, articleImageFor } from "../../data/media";

const articles = (await getCollection("insights", ({ data }) => !data.draft)).sort(
  (a, b) =>
    (b.data.order ?? 0) - (a.data.order ?? 0) ||
    b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);

const fmt = (d: Date) =>
  d.toLocaleDateString("en-CA", { year: "numeric", month: "short", day: "numeric" });
---

<Main
  title="Insights - SyncI&DLabs"
  description="Articles and opinion pieces on resilient neighbourhood design, sovereign energy and compute, the pre-commercialization gap, and the futures SyncID actualizes."
  lang="en"
  activePath="/insights"
>
  <PageHeader
    eyebrow="Insights"
    title="Articles and opinion, from practice."
    lead="Writing on resilient neighbourhood design, sovereign energy and compute, and the pre-commercialization layer Canada's innovation economy is missing. Evidence-based, specifically sourced."
    image={BAN_INSIGHTS}
    imageAlt="Editorial concept imagery for Insights"
  />

  <section>
    <div class="mx-auto max-w-7xl px-6 py-16 lg:px-10">
      {
        articles.length === 0 ? (
          <p class="text-lg leading-relaxed text-graphite">Articles are on the way.</p>
        ) : (
          <div class="grid grid-cols-1 gap-px bg-hairline sm:grid-cols-2 lg:grid-cols-3">
            {articles.map((a, i) => {
              const slug = a.id.replace(/\.mdx?$/, "");
              return (
                <ArticleCard
                  href={`/en/insights/${slug}`}
                  image={a.data.image ?? articleImageFor(slug, i)}
                  title={a.data.title}
                  date={fmt(a.data.publishDate)}
                  categories={[a.data.kind === "cross-post" ? "Cross-post" : "Insight"]}
                  meta={a.data.summary ?? a.data.description}
                />
              );
            })}
          </div>
        )
      }
    </div>
  </section>
</Main>
