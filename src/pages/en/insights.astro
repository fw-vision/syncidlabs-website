---
import Main from "../../layouts/Main.astro";
---

<Main
  title="Insights - SyncID Labs"
  description="News, releases, and articles from SyncID Labs."
  lang="en"
  activePath="/insights"
>
  <section class="border-b border-neutral-200">
    <div class="mx-auto max-w-3xl px-6 py-20">
      <h1 class="text-4xl font-semibold tracking-tight text-neutral-900">Insights</h1>
      <p class="mt-6 text-lg leading-relaxed text-neutral-500">
        News and releases will appear here.
      </p>
    </div>
  </section>
</Main>
