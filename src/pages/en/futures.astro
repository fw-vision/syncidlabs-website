---
import Main from "../../layouts/Main.astro";
import PageHeader from "../../components/PageHeader.astro";

const domains = [
  { name: "Food sovereignty", line: "Domestic production capacity that closes the import dependency." },
  { name: "Sovereign compute", line: "Distributed, dual-use compute Canada owns and controls." },
  { name: "Climate tech", line: "Storage, grid, and materials built for a colder, longer horizon." },
  { name: "Future of work", line: "Hybrid Intelligence practice that keeps skilled work in Canada." },
  { name: "Education", line: "Research-to-venture pipelines that retain graduates." },
  { name: "Health and femtech", line: "Care and diagnostics designed around real Canadian need." },
  { name: "Deep tech and robotics", line: "Manufacturing and automation that rebuild industrial capacity." },
];
---

<Main
  title="Strategic Futures - SyncID Labs"
  description="The strategic futures we actualize for Canada: food sovereignty, sovereign compute, climate tech, future of work, education, health, and deep tech."
  lang="en"
  activePath="/futures"
>
  <PageHeader
    eyebrow="Strategic futures"
    title="Strategic futures we actualize."
    lead="Each future names a Canadian challenge and the direction we build toward. Buildable, not speculative."
  />

  <section class="border-b border-hairline">
    <div class="mx-auto max-w-7xl px-6 py-16 lg:px-10">
      <div class="grid grid-cols-1 gap-px bg-hairline md:grid-cols-2">
        {
          domains.map((d) => (
            <div class="bg-canvas p-8">
              <h2 class="font-display text-xl font-medium text-ink">{d.name}</h2>
              <p class="mt-3 text-base leading-relaxed text-graphite">{d.line}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section>
    <div class="mx-auto max-w-3xl px-6 py-20 lg:px-10">
      <p class="text-xl leading-relaxed text-graphite">
        Anchor ventures include DAICompute (sovereign compute), Iterra (food), Arcadia Wellness
        (health), and Nova Roma with Perceptiosphere (education and research). Each is a buildable
        future we are working toward, not a forecast.
      </p>
    </div>
  </section>
</Main>
