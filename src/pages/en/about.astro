---
import Main from "../../layouts/Main.astro";
import PageHeader from "../../components/PageHeader.astro";
import StatCounter from "../../components/StatCounter.astro";
import Placeholder from "../../components/Placeholder.astro";
---

<Main
  title="About - SyncID Labs"
  description="A venture-studio pioneer since 2013, SyncID Labs has spent a decade inside the Canadian innovation gap. We build, we do not forecast."
  lang="en"
  activePath="/about"
>
  <PageHeader
    eyebrow="Who we are"
    title="A decade inside the Canadian innovation gap."
    lead="SyncID Labs is the operational, build-oriented member of a wider constellation. We build, we do not forecast."
  />

  <section>
    <div class="mx-auto max-w-3xl px-6 py-20 lg:px-10">
      <div class="space-y-7 text-lg leading-relaxed text-graphite">
        <p>
          SyncID Labs, Synchronous Incubation and Development Labs, has operated on the
          venture-studio model since 2013, before the term existed. We have spent a decade inside
          the Canadian innovation gap, and we know why founders leave, why IP is lost, and why
          districts fail.
        </p>
        <p>
          Our credibility is grounded: doctoral work under review at the University of Waterloo and
          the University of Calgary; a network across the University of Toronto, Toronto
          Metropolitan University, and the venture ecosystem; venture exits of $70M and $650M.
        </p>
        <p class="text-ink">
          We do not forecast Canada's future. We build it, venture by venture, on land in Markham.
        </p>
        <p>
          FW.VISION provides the governance and futures research. SyncID actualizes.
        </p>
      </div>
    </div>
  </section>

  <section class="border-t border-hairline">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-10">
      <StatCounter
        stats={[
          { value: "2013", label: "Venture-studio pioneer" },
          { value: "$70M", label: "Venture exit" },
          { value: "$650M", label: "Venture exit" },
          { value: "2", label: "Doctoral programs" },
        ]}
      />
    </div>
  </section>

  <!-- Founder / leadership -->
  <section class="border-t border-hairline">
    <div class="mx-auto grid max-w-7xl items-center gap-12 px-6 py-20 lg:grid-cols-2 lg:px-10">
      <Placeholder
        kind="image"
        ratio="4/5"
        label="Professional portrait of Francis Wang (founder)"
        note="A single credible headshot. Councillors and capital partners look for a real face behind the proponent."
      />
      <div>
        <p class="eyebrow text-graphite/60">Leadership</p>
        <h2 class="font-display mt-6 text-3xl font-medium leading-tight text-ink sm:text-4xl">
          Francis Wang
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-graphite">
          Founder of SyncID Labs. Venture-studio operator, doctoral researcher, and the architect
          of the actualizer method. Two venture exits, doctoral work under review at Waterloo and
          Calgary, and a decade inside the Canadian innovation gap.
        </p>
      </div>
    </div>
  </section>

  <!-- Affiliations wall -->
  <section class="border-t border-hairline">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-10">
      <p class="eyebrow text-graphite/60">Affiliations and networks</p>
      <div class="mt-8">
        <Placeholder
          kind="image"
          ratio="21/9"
          label="Institution logo wall: Waterloo, Calgary, UofT, TMU, Quantic, Golden Gate"
          note="A grayscale logo grid, subject to permission. Signals institutional grounding without overclaiming endorsement."
        />
      </div>
    </div>
  </section>
</Main>
