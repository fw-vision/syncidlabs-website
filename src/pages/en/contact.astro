---
import Main from "../../layouts/Main.astro";
import PageHeader from "../../components/PageHeader.astro";
import BusinessCard from "../../components/BusinessCard.astro";
import { BAN_CONTACT } from "../../data/media";

const paths = [
  {
    audience: "Civic and government",
    body: "Endorsement, design-partner designation, and the follow-up meeting to review the district plan.",
  },
  {
    audience: "Capital",
    body: "The de-risked, methodology-backed coalition play toward defined Canadian futures.",
  },
  {
    audience: "Institutions and founders",
    body: "Bring your research, your venture, your alumni to a district built for actualizing Canada's futures.",
  },
];
---

<Main
  title="Contact - SyncI&DLabs"
  description="Start a conversation with SyncI&DLabs about the innovation district, partnership, or capital."
  lang="en"
  activePath="/contact"
>
  <PageHeader
    eyebrow="Contact"
    title="Start a conversation."
    lead="We welcome civic, institutional, capital, and founder enquiries. The clearest first step is a direct conversation."
    image={BAN_CONTACT}
    imageAlt="Purposeful workspace collaboration"
  />

  <!-- Engagement paths per audience -->
  <section class="border-b border-hairline">
    <div class="mx-auto max-w-7xl px-6 py-16 lg:px-10">
      <p class="eyebrow text-graphite/60">Engagement paths</p>
      <div class="mt-8 grid grid-cols-1 gap-px bg-hairline md:grid-cols-3">
        {
          paths.map((p) => (
            <div class="bg-canvas p-8">
              <h2 class="font-display text-xl font-medium text-ink">{p.audience}</h2>
              <p class="mt-3 text-base leading-relaxed text-graphite">{p.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Direct enquiry + business cards -->
  <section>
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-10">
      <p class="eyebrow text-graphite/60">Direct</p>
      <a
        href="mailto:hello@syncidlabs.com"
        class="accent-link font-display mt-6 inline-block text-2xl font-medium sm:text-3xl"
      >
        hello@syncidlabs.com
      </a>
      <p class="mt-6 max-w-xl text-base leading-relaxed text-graphite">
        For civic and partnership enquiries, a direct note is the fastest path. We reply
        personally. Cards for the founder and head of strategic growth:
      </p>

      <div class="mt-12 grid grid-cols-1 justify-items-center gap-8 lg:grid-cols-2 lg:justify-items-stretch">
        <BusinessCard
          name="Francis Wang"
          role="Founder, President"
          phone="226-808-0775"
          email="francis.wang@syncidlabs.com"
          photoSrc="/images/francis_squared.jpg"
        />
        <BusinessCard
          name="William Yao"
          role="Head of Strategic Growth"
          phone="289-637-7786"
          email="william.yao@syncidlabs.com"
        />
      </div>
    </div>
  </section>
</Main>
