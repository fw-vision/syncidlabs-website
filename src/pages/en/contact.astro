---
import Main from "../../layouts/Main.astro";
import PageHeader from "../../components/PageHeader.astro";
---

<Main
  title="Contact - SyncID Labs"
  description="Start a conversation with SyncID Labs about the innovation district, partnership, or capital."
  lang="en"
  activePath="/contact"
>
  <PageHeader
    eyebrow="Contact"
    title="Start a conversation."
    lead="We welcome civic, institutional, capital, and founder enquiries. The clearest first step is a direct conversation."
  />

  <section>
    <div class="mx-auto max-w-3xl px-6 py-20 lg:px-10">
      <a
        href="mailto:hello@syncidlabs.com"
        class="accent-link font-display text-2xl font-medium sm:text-3xl"
      >
        hello@syncidlabs.com
      </a>
    </div>
  </section>
</Main>
