---
import Main from "../../layouts/Main.astro";
---

<Main
  title="Contact - SyncID Labs"
  description="Start a conversation with SyncID Labs about the innovation district, partnership, or capital."
  lang="en"
  activePath="/contact"
>
  <section class="border-b border-neutral-200">
    <div class="mx-auto max-w-3xl px-6 py-20">
      <h1 class="text-4xl font-semibold tracking-tight text-neutral-900">Start a conversation</h1>
      <p class="mt-6 text-lg leading-relaxed text-neutral-700">
        We welcome civic, institutional, capital, and founder enquiries. The clearest first step is
        a direct conversation.
      </p>
      <p class="mt-8 text-lg text-neutral-800">
        <a href="mailto:hello@syncidlabs.com" class="font-medium" style="color: var(--wk-accent);"
          >hello@syncidlabs.com</a
        >
      </p>
    </div>
  </section>
</Main>
