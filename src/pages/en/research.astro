---
import Main from "../../layouts/Main.astro";
import PageHeader from "../../components/PageHeader.astro";
import Placeholder from "../../components/Placeholder.astro";

const stats = [
  {
    value: "71%",
    claim: "Canadian productivity has fallen to 71% of the US level.",
    source: "Bank of Canada, 2024",
  },
  {
    value: "1.81% vs 2.73%",
    claim: "R&D intensity is 1.81% of GDP, against an OECD average of 2.73%.",
    source: "Statistics Canada, 2024",
  },
  {
    value: "1.2M+",
    claim:
      "Canadians made more than 1.2 million TN professional-work entries into the United States in fiscal 2023.",
    source: "US Department of Homeland Security",
    caveat:
      "These are admissions, not distinct individuals; one person may enter multiple times.",
  },
  {
    value: "44.3%",
    claim: "Foreign firms control 44.3% of Canadian manufacturing assets.",
    source: "Statistics Canada, 2023",
  },
];
---

<Main
  title="The Evidence - SyncID Labs"
  description="The verified problem statement behind SyncID Labs: productivity, R&D intensity, skilled emigration, and foreign control. Every figure sourced."
  lang="en"
  activePath="/research"
>
  <PageHeader
    eyebrow="The evidence"
    title="Canada generates world-class research and talent, then loses the value of both."
    lead="The problem statement below is verified. Every figure is sourced."
  />

  <!-- Lead data visual: the gap at a glance -->
  <section class="border-b border-hairline">
    <div class="mx-auto max-w-7xl px-6 py-12 lg:px-10">
      <Placeholder
        kind="data"
        ratio="21/9"
        label="Headline chart: Canadian productivity vs US (or R&D intensity vs OECD), 2000 to 2024"
        note="A single authoritative chart that makes the gap legible at a glance. Source data from Bank of Canada / StatCan; render with fw-vision dataviz."
      />
    </div>
  </section>

  <section class="border-b border-hairline">
    <div class="mx-auto max-w-7xl px-6 py-16 lg:px-10">
      <p class="eyebrow text-graphite/60">The five gaps, verified</p>
      <div class="mt-8 grid grid-cols-1 gap-px bg-hairline md:grid-cols-2">
        {
          stats.map((s) => (
            <div class="bg-canvas p-9">
              <p class="font-display text-4xl font-medium text-ink lg:text-5xl">{s.value}</p>
              <p class="mt-4 text-lg leading-relaxed text-ink">{s.claim}</p>
              <p class="mt-4 text-sm font-medium text-graphite">{s.source}</p>
              {s.caveat && <p class="mt-1 text-sm italic text-graphite/70">{s.caveat}</p>}
            </div>
          ))
        }
      </div>
      <p class="mt-10 max-w-3xl text-base leading-relaxed text-graphite">
        The Council of Canadian Academies (2025) reports the same pattern at a systemic level:
        strong inputs, weak outcomes.
      </p>
    </div>
  </section>

  <section>
    <div class="mx-auto max-w-3xl px-6 py-20 lg:px-10">
      <p class="eyebrow text-graphite/60">The opportunity</p>
      <p class="mt-6 text-2xl leading-snug text-ink">
        Canada's long-horizon potential is measured in the multiple trillions of dollars.
      </p>
      <p class="mt-5 text-lg leading-relaxed text-graphite">
        We treat this as a scenario range, not a forecast. The precedent is close to home: the
        Waterloo region generated tens of billions in value between 2013 and 2023. A district that
        keeps talent, IP, and ventures at home can do the same, deliberately.
      </p>
    </div>
  </section>
</Main>
