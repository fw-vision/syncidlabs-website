---
import Main from "../../../layouts/Main.astro";
---

<Main title="Privacy - SyncID Labs" lang="en" activePath="/legal/privacy">
  <section class="border-b border-neutral-200">
    <div class="mx-auto max-w-3xl px-6 py-20">
      <h1 class="text-4xl font-semibold tracking-tight text-neutral-900">Privacy</h1>
      <p class="mt-6 text-lg leading-relaxed text-neutral-700">
        SyncID Labs collects only the information you choose to share when you contact us. We do not
        sell personal information. This is a draft policy and will be expanded before launch.
      </p>
    </div>
  </section>
</Main>
